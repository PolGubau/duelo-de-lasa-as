{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm --dir ../.. install --frozen-lockfile",
  "buildCommand": "pnpm --dir ../.. --filter web build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/sala/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/tutorial",
      "destination": "/index.html"
    }
  ]
}
